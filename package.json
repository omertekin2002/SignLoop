{
  "name": "my-turbo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "db:migrate": "bun --filter web db:migrate"
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "turbo": "^2.10.4",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@assistant-ui/core": "0.1.10",
    "@assistant-ui/store": "0.2.6",
    "@assistant-ui/tap": "0.5.6",
    "form-data": "4.0.6",
    "postcss": "8.5.16",
    "undici": "6.27.0",
    "ws": "8.21.0"
  }
}
