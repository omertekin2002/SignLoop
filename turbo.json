{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "CLERK_SECRET_KEY",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "GEMINI_API_KEY",
    "GEMINI_SEARCH_MODEL",
    "WEB_SEARCH_PROVIDER",
    "BRAVE_SEARCH_API_KEY",
    "OPENROUTER_API_KEY",
    "OPENROUTER_BASE_URL",
    "PRIMARY_LLM_BASE_URL",
    "PRIMARY_LLM_MODEL",
    "PRIMARY_LLM_API_KEY",
    "BLOB_READ_WRITE_TOKEN",
    "BLOB_STORE_ID",
    "BLOB_ACCESS",
    "VERCEL_OIDC_TOKEN",
    "POSTGRES_URL",
    "POSTGRES_URL_NON_POOLING",
    "LOCAL_STORAGE_PATH",
    "LOCAL_STORAGE_BUCKET",
    "SKIP_SCHEMA_BOOTSTRAP",
    "NEXT_RUNTIME",
    "LANGFUSE_PUBLIC_KEY",
    "LANGFUSE_SECRET_KEY",
    "LANGFUSE_BASE_URL",
    "LANGFUSE_RECORD_CONTENT",
    "FIRECRAWL_API_KEY",
    "JINA_API_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^test"],
      "env": ["SIGNLOOP_TEST_DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
