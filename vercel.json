{
  "framework": "nextjs",
  "installCommand": "bun install --frozen-lockfile --linker hoisted",
  "buildCommand": "bunx turbo build --filter=web",
  "outputDirectory": "apps/web/.next",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- apps/web/ packages/ package.json bun.lock turbo.json vercel.json",
  "crons": [
    { "path": "/api/cron/storage-cleanup", "schedule": "0 3 * * *" }
  ]
}
