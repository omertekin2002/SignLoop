# Optional OpenAI-compatible generation path tried first
# (configure both URL and key, or omit both)
# PRIMARY_LLM_BASE_URL=https://your-primary-provider.example/v1
# PRIMARY_LLM_API_KEY=replace-with-a-primary-provider-key
# PRIMARY_LLM_MODEL=gpt-6.1-sol

# Gemini: generation fallback after the primary, and a search option.
# Search selection defaults to Brave, Firecrawl, then Gemini.
GEMINI_API_KEY=replace-with-a-gemini-api-key
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_SEARCH_MODEL=gemini-2.5-flash

# Ordered fallback path (optional when the primary path is configured)
OPENROUTER_API_KEY=replace-with-an-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FALLBACK_MODELS=openrouter/free

# Service settings
PUBLIC_SERVICE_URL=http://localhost:10000
APP_NAME=SignLoop Chat Service
PORT=10000
MAX_CONCURRENT_REQUESTS=4
REQUEST_TIMEOUT_MS=275000

# Comma-separated explicit origins; leave empty to disable CORS
CORS_ALLOWED_ORIGINS=

# Optional search override and integrations
# WEB_SEARCH_PROVIDER=brave
# BRAVE_SEARCH_API_KEY=replace-with-a-brave-key
# FIRECRAWL_API_KEY=replace-with-a-firecrawl-key
# JINA_API_KEY=replace-with-a-jina-key

# Opt-in primary image tool; exposed only when /models advertises this model
ENABLE_IMAGE_GENERATION=false
IMAGE_GENERATION_MODEL=gpt-image-2.5-sunburst
