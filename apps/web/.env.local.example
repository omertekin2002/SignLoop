NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Optional primary OpenAI-compatible provider. Configure URL and key together; SignLoop does not
# use a built-in endpoint or invented credential when either value is absent.
PRIMARY_LLM_BASE_URL=https://your-openai-compatible-provider.example/v1
PRIMARY_LLM_API_KEY=...
PRIMARY_LLM_MODEL=your-model-id

# OpenRouter is used when explicitly configured here and the primary provider is unavailable.
# Invalid analysis output is not resent to another provider merely to retry schema validation.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Gemini performs one Google-grounded search before any selected chat model when the web-search
# toggle is enabled. The default model matches OpenClaw's low-cost search-worker setup.
GEMINI_API_KEY=...
# GEMINI_SEARCH_MODEL=gemini-2.5-flash
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required for Vercel Postgres.
POSTGRES_URL=postgres://...
POSTGRES_URL_NON_POOLING=postgres://...

# Set to 1 in deployed environments after `bun run db:migrate` has applied the schema. Leave unset
# for local first-run environments that rely on the idempotent runtime schema bootstrap.
# SKIP_SCHEMA_BOOTSTRAP=1

# Vercel Blob object storage. New Vercel connections can use OIDC with BLOB_STORE_ID;
# VERCEL_OIDC_TOKEN is injected by Vercel. Local development can use a read-write token instead.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# BLOB_STORE_ID=store_...
# Strongly recommended for legal documents; this must match the configured Blob store's access.
BLOB_ACCESS=private

# Optional local object storage fallback overrides (dev only).
LOCAL_STORAGE_PATH=./uploads
LOCAL_STORAGE_BUCKET=signloop-contracts
