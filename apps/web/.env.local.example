# Copy this file to apps/web/.env.local and replace the required placeholders.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Runtime pooled SQL and the standalone migration client use different connection variables.
POSTGRES_URL=postgres://...
POSTGRES_URL_NON_POOLING=postgres://...

# Configure a primary provider and/or OpenRouter to enable inference.
# The primary URL must include the API prefix (usually /v1) and support Responses API tools.
# An empty API key is valid only if the endpoint intentionally allows unauthenticated requests.
# PRIMARY_LLM_BASE_URL=https://your-openai-compatible-provider.example/v1
# PRIMARY_LLM_API_KEY=
# Anonymous chat uses this default (gemini-3-flash if unset); signed-in requests use model discovery.
# PRIMARY_LLM_MODEL=your-model-id

# OpenRouter supplies fallback inference and allows pinning openrouter/free in the model selector.
# Invalid analysis output is not resent to another provider solely to retry schema validation.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional model-selected web search; it does not run automatically on every chat turn.
# Without an override, configured keys are preferred in order: Brave, Firecrawl, Gemini.
# WEB_SEARCH_PROVIDER=brave
# BRAVE_SEARCH_API_KEY=...
# FIRECRAWL_API_KEY=fc-...
# GEMINI_API_KEY=...
# GEMINI_SEARCH_MODEL=gemini-2.5-flash

# read_url also uses FIRECRAWL_API_KEY. With no key, or on a recoverable Firecrawl failure,
# it uses Jina Reader. JINA_API_KEY is optional.
# JINA_API_KEY=jina_...

# Set only after applying migrations to this database. Otherwise the first runtime database
# operation runs pending migrations. The Vercel build command does not run migrations.
# SKIP_SCHEMA_BOOTSTRAP=1

# Optional Vercel Blob storage. BLOB_STORE_ID uses Vercel OIDC authentication;
# VERCEL_OIDC_TOKEN is supplied by the Vercel environment. Local use can supply a read-write token.
# Leave both settings unset to use the local development storage directory.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# BLOB_STORE_ID=store_...
# Defaults to private; must match the actual store. Existing public stores must explicitly opt in.
# BLOB_ACCESS=private

# With no Blob configuration, development defaults to the workspace's uploads directory.
# Production local storage requires an explicit persistent writable path; Vercel function
# storage is not a durable substitute for Blob. Relative paths use the process working directory.
# LOCAL_STORAGE_PATH=./uploads
# LOCAL_STORAGE_BUCKET=signloop-contracts

# Optional AI SDK chat tracing. Both keys are required; otherwise instrumentation is disabled.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# false disables SDK input/output recording; it is not a blanket tool/log redaction setting.
# LANGFUSE_RECORD_CONTENT=false

# Shared chat admission limits (PostgreSQL-backed; anonymous callers share a bucket).
CHAT_DAILY_REQUEST_LIMIT=1000
CHAT_CONCURRENCY_LIMIT=8
